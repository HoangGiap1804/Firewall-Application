@startuml UseCaseLogManagement
!theme plain
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor LightYellow
}

title Use Case Diagram - Quản lý Logs

actor User as user

rectangle "Log Management" {
  usecase "UC-10: Xem Logs" as UC10
}

user --> UC10

note right of UC10
  Hiển thị logs hệ thống
  Theo dõi hoạt động
  và sự kiện
end note

@enduml

