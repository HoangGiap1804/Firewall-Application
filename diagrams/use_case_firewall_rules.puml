@startuml UseCaseFirewallRules
!theme plain
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor LightBlue
}

title Use Case Diagram - Quản lý Firewall Rules

actor User as user
actor "Firewall Service" as service

rectangle "Firewall Rules Management" {
  usecase "UC-01: Xem danh sách Rules" as UC01
  usecase "UC-02: Thêm Rule mới" as UC02
  usecase "UC-03: Xóa Rule" as UC03
  usecase "UC-04: Tìm kiếm Rules" as UC04
  usecase "UC-05: Quản lý Available Rules" as UC05
}

user --> UC01
user --> UC02
user --> UC03
user --> UC04
user --> UC05

service --> UC01
service --> UC02
service --> UC03
service --> UC04

note right of UC01
  Hiển thị tất cả rules từ các chains
  Auto-refresh mỗi 1.5 giây
end note

note right of UC02
  Thêm rule mới vào iptables
  Validate input (Protocol, Action)
end note

note right of UC03
  Xóa một hoặc nhiều rules
  Hỗ trợ xóa từ nhiều chains
end note

@enduml

