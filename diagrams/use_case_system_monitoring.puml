@startuml UseCaseSystemMonitoring
!theme plain
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor LightGreen
}

title Use Case Diagram - Giám sát Hệ thống

actor User as user
actor "System Monitor" as monitor
actor "Firewall Service" as service

rectangle "System Monitoring" {
  usecase "UC-06: Xem biểu đồ Monitoring" as UC06
  usecase "UC-07: Xem thống kê tài nguyên" as UC07
  usecase "UC-08: Phát hiện Anomaly" as UC08
  usecase "UC-09: Nhận cảnh báo" as UC09
}

user --> UC06
user --> UC07
user --> UC09

monitor --> UC08
monitor --> UC09

service --> UC06
service --> UC07
service --> UC08

UC08 ..> UC09 : <<triggers>>

note right of UC06
  Biểu đồ real-time:
  - CPU, RAM, Network
  - Temperature
  - Sandbox & Host charts
end note

note right of UC07
  Thống kê chi tiết:
  - CPU %, RAM MB
  - Disk I/O
  - Network RX/TX
  - Services count
end note

note right of UC08
  Phát hiện tự động:
  - CPU > 85%
  - RAM spike > 150MB
  - Services > 10
end note

note right of UC09
  Cảnh báo qua:
  - Desktop notification
  - Email alert
end note

@enduml

