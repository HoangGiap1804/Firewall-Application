@startuml UseCaseOverview
!theme plain
skinparam actorStyle awesome
skinparam rectangle {
    BackgroundColor LightGray
}

title Use Case Diagram - Tổng quan Hệ thống

actor User as user
actor "System Monitor" as monitor
actor "Firewall Service" as service

rectangle "Firewall Management System" {
  rectangle "Firewall Rules\nManagement" as RulesModule
  rectangle "System\nMonitoring" as MonitorModule
  rectangle "Log\nManagement" as LogModule
}

user --> RulesModule : Quản lý Rules
user --> MonitorModule : Xem Monitoring
user --> LogModule : Xem Logs

monitor --> MonitorModule : Phát hiện Anomaly

service --> RulesModule : Xử lý Rules
service --> MonitorModule : Thu thập dữ liệu

note right of RulesModule
  UC-01 đến UC-05
  Quản lý firewall rules
end note

note right of MonitorModule
  UC-06 đến UC-09
  Giám sát và cảnh báo
end note

note right of LogModule
  UC-10
  Xem logs hệ thống
end note

@enduml

