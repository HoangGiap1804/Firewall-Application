@startuml LayeredArchitecture
!theme plain
skinparam componentStyle rectangle
skinparam linetype ortho

title Kiến trúc Hệ thống - Sơ đồ các Layer\nHệ thống Quản lý Firewall với Giám sát Hệ thống

' PRESENTATION LAYER - Top
package "PRESENTATION LAYER\n(Frontend - PyQt6 GUI)" #LightBlue {
    component [Main Window] as MainWindow
    component [UI Components\n(5 Tabs)] as UI
    component [Tab Handlers] as Handlers
    component [Monitoring & Charts] as Monitoring
    component [API Client] as APIClient
    
    MainWindow --> UI
    MainWindow --> Handlers
    MainWindow --> Monitoring
    MainWindow --> APIClient
    Handlers --> UI
    Monitoring --> UI
}

' APPLICATION LAYER - Middle
package "APPLICATION LAYER\n(Backend Service - Flask API)" #LightGreen {
    component [Flask Service] as FlaskService
    component [REST API\nEndpoints] as API
    component [Business Logic] as BusinessLogic
    component [Monitoring Thread] as MonitorThread
    component [Notifications] as Notifications
    
    FlaskService --> API
    FlaskService --> BusinessLogic
    FlaskService --> MonitorThread
    BusinessLogic --> Notifications
    MonitorThread --> Notifications
}

' DATA LAYER - Bottom
package "DATA LAYER\n(System Resources)" #LightYellow {
    component [iptables] as Iptables
    component [System Commands\nsystemctl, tail] as Commands
    component [System Interfaces\ncgroup, psutil, thermal] as Interfaces
    component [File Storage\nJSON, Logs] as Files
}

' Vertical flow connections - these establish the vertical order
APIClient --> API : HTTP REST API
API --> BusinessLogic
BusinessLogic --> Iptables
BusinessLogic --> Commands
MonitorThread --> Interfaces
BusinessLogic --> Files

' Additional vertical connections to reinforce layout
MainWindow --> FlaskService
FlaskService --> Iptables

note bottom of MainWindow
  **Frontend**
  - PyQt6 GUI
  - 5 Tabs
  - Real-time updates
end note

note bottom of FlaskService
  **Backend**
  - Flask REST API
  - localhost:5000
  - Background threads
end note

note bottom of Iptables
  **System**
  - Requires root
  - Direct access
end note

@enduml
